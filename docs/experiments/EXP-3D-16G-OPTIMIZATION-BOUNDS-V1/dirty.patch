+    fig.suptitle("Oracle fits both scored queries jointly; not a deployable ranking")
+    save(fig, "05_context_vs_privileged_oracle")
+
+    fig, ax = plt.subplots(figsize=(9, max(5, len(scenes) * 0.32)))
