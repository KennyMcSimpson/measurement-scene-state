+        anchor = torch.tensor(
+            next(f for f in record["frames"] if f["frame_id"] == record["roles"]["context_a"][0])[
+                "c2w"
+            ],
+            dtype=torch.float32,
+        )
+        for role in ("A", "B"):
+            context = loader.context(role)
+            state = states[f"C0:{config['seeds'][0]}:{sid}/{role}"]
+            for qid in record["roles"]["primary_query"]:
