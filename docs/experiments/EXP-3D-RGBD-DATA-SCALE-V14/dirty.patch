+                {
+                    "scene_id": sid,
+                    "split": "FRESH_QUALIFICATION",
+                    "historically_exposed": False,
+                    "historical_exposure_basis": lock["independence_basis"],
+                    "physical_scene_id": "|".join(asset_identity(assets[sid])),
+                    "roles": roles,
+                    "frames": frames,
+                }
+            )
+            print("PREPARED", sid, flush=True)
