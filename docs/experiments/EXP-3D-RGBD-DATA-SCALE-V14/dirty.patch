+    amended["scenes"] = fresh["scenes"] + records
+    amended["amendment1_lock_sha256"] = base.sha(root / "amendment1_lock.json")
+    base.write(root / "manifest_fresh_amended.json", amended)
+    base.write(
+        root / "amendment1_result.json",
