+                    "scene_id": record["scene_id"],
+                    "frame_id": frame["frame_id"],
+                    "path": str(path),
+                    "sha256": sha(path),
+                    "purpose": "frozen_global_training_depth_prior",
+                }
+            )
+            depth = np.load(path).reshape(-1)
+            values.append(depth[np.isfinite(depth) & (depth > 0)])
