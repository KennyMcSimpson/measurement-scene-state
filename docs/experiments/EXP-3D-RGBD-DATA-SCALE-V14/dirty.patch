+    }[branch]
+    fit = train_fit(curves, contract["steps"])
+    last = last_step_dev(curves, contract["steps"])
+    fields = {
+        "N_TRAIN_SCENES_BY_VARIANT": {"C0": 72, "C1": 72, "C2": 72},
+        "GRID_BY_VARIANT": {"C0": 16, "C1": 32, "C2": 24},
+        "BOUNDS_RULE": contract.get("bounds_rule", "NOT_RECORDED"),
+        "N_DEV_SCENES": len(results["scene_ids"]),
+        "DEVICE": "cpu",
+        "STEPS": contract["steps"],
+        "SECONDARY_C2_STATUS": c2_status,
+        "GRID16_QUERY_ABSREL": number(groups["C0|direct"]["query_metrics"]["depth_absrel"]["mean"]),
+        "GRID32_QUERY_ABSREL": number(groups["C1|direct"]["query_metrics"]["depth_absrel"]["mean"]),
+        "GRID24_QUERY_ABSREL": number(groups["C2|direct"]["query_metrics"]["depth_absrel"]["mean"])
+        if secondary
+        else "NOT_RUN_SECONDARY_OPTIONAL",
+        "RESOLUTION_GAIN": number(scale["mean"]),
+        "RESOLUTION_GAIN_CI": scale["ci95"],
