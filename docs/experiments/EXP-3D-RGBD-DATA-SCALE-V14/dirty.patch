+                rows.append(row)
+            contexts.extend(result["context_rows"])
+            training.extend(
+                {"variant": variant, "seed": seed, **__import__("json").loads(line)}
+                for line in (run / "training.jsonl").read_text().splitlines()
+            )
+            devcurves.extend(
