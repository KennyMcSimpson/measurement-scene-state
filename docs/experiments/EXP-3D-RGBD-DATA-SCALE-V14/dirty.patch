+        for r in manifest["scenes"]
+        for f in r["frames"]
+        for kind in ("rgb", "depth")
+    }
+    write_json(root / "audit/data_hashes.json", data_hashes)
+    names = (
+        "scene_split.json",
+        "stream_roles.json",
