+
+
+@pytest.mark.parametrize(
+    "scores,status",
+    [
+        ({"S0": 0.4, "S1": 0.3, "S2": 0.35, "S3": 0.5}, "HARMFUL"),
+        ({"S0": 0.4, "S1": 0.3, "S2": 0.3, "S3": 0.2}, "COMPLEMENTARY"),
+        ({"S0": 0.4, "S1": 0.3, "S2": 0.4, "S3": 0.3}, "FREE_SPACE_DOMINANT"),
+        ({"S0": 0.4, "S1": 0.4, "S2": 0.3, "S3": 0.3}, "SURFACE_DOMINANT"),
