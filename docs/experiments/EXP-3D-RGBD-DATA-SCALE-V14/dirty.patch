+            for readout in ("RAW", "OPACITY_NORMALIZED", "MEDIAN_SCALED")
+            for metric in ("depth_absrel", "depth_delta1")
+        }
+        for v in variants
+        if f"V8_{v}" in block
+    }
+
+
+def run(root, docs=None):
