+    assert len({parameter_hash(c) for c in carriers.values()}) == 1
+    counts = {v: sum(p.numel() for p in c.parameters()) for v, c in carriers.items()}
+    assert counts == {"C0": 5150, "C1": 5150, "C2": 5125}
