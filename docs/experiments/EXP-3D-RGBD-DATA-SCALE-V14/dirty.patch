+    )
+    locked = [
+        "config.json",
+        "state_plan.json",
+        "scene_manifest.json",
+        "optimization_budget_lock.json",
+        "bounds_lock.json",
+        "bounds_contract.json",
+        "decision_rules.json",
+    ]
+    write_json(
