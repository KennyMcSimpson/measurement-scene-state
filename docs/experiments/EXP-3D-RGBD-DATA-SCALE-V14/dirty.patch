+    regional = result["observability_analysis"]["regions"]["S0"]
+    assert regional["OBS2PLUS"]["conditional_absrel"]["per_scene"]["d"] is None
+    assert regional["OBS2PLUS"]["additive_error_contribution"]["per_scene"]["d"] == 0
+    for scene in ("a", "b", "c", "d"):
