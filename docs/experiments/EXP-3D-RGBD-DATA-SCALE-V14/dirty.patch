+    assert plateau(checks, trace[:3], 1000, rules()["plateau"])["status"].startswith("UNKNOWN")
+    checks[-1]["context_objective"] = 1.5
+    assert plateau(checks, trace, 1000, rules()["plateau"])["status"] == "NOT_PLATEAU"
