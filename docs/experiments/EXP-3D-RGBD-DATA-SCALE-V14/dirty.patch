+#!/usr/bin/env python3
+"""V9 training-view-count runs of the Core A recipe; no writer or test cohort access."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from mcss.dynamic.types import hash_value
+from mcss.geometry import transform_cameras
+from mcss.mechanism_pilot.geometry_carrier_experiment import (
+    select_checkpoint,
+    verify_data,
+    verify_lock,
+)
+from mcss.mechanism_pilot.rgbd_stream_write import StreamRGBDLoader
