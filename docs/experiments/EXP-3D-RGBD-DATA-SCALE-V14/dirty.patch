+AMENDMENT = Path(__file__).with_name("analyze_rgbd_bounds_carrier_amend1.py")
+
+
+def _amended_analyze():
+    spec = importlib.util.spec_from_file_location("v7_amendment1", AMENDMENT)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.amended_analyze()
+
+
+analyze = _amended_analyze()
+
+
+def load(root, name, provenance):
+    path = root / name
