+#!/usr/bin/env python3
+"""Freeze the Core B V2 protocol (learned writes on the frozen V9 carrier, CPU only)."""
+
+from __future__ import annotations
+
+import argparse
+import datetime
+import shutil
+import subprocess
+import sys
