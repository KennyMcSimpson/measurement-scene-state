+#!/usr/bin/env python3
+"""V10 raw-only statistics with the V7-amended V2 estimator and eight figures.
+
+V10 varies the bounds prior, so per-scene ray-hit fractions differ between variants by
+design; the estimator is the V7 Amendment 1 one, which removes only the frozen C0/C1
+ray-hit equality assertion. Ray-hit fractions are reported (descriptive)."""
+
+import argparse
+import gzip
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
