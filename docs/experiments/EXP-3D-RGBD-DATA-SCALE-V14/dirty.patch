+#!/usr/bin/env python3
+"""Report the frozen FRESH-V2 qualification of the V7 RGB-D carriers (saved results only)."""
+# ruff: noqa: E501 -- Chinese scientific report prose
+
+import argparse
+import json
+import shutil
+from collections import defaultdict
+from pathlib import Path
+
