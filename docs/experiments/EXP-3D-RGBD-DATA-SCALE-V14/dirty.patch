+            "interpretation": {
+                "A": "DEPTH_STATUS=SUPPORTED and SCENE_SPECIFICITY_STATUS=SUPPORTED and "
+                "C1 RAW AbsRel ABOVE REF_TRAIN_ABSREL_OPTIMAL (GEOMETRY_FREE_REFERENCE)",
+                "B": "DEPTH_GAIN CIlo>0 or SCENE_SPECIFICITY_STATUS=SUPPORTED or C1 RAW "
