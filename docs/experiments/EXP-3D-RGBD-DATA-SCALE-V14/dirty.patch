+    docs.mkdir(parents=True, exist_ok=True)
+    for path in sorted(root.iterdir()):
+        if path.is_file() and (
+            path.suffix in (".json", ".md", ".sh", ".txt", ".patch")
+            or path.name == "source_snapshot.tar.gz"
