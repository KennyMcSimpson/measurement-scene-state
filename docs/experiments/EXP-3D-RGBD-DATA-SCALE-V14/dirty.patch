+            manifest["FINAL_HOLDOUT_PROHIBITED"]
+        ):
+            raise ValueError("Manifest roster must match exposed scenes without holdout")
+        if any(
+            query_ids[scene] != set(records[scene]["roles"]["primary_query"]) for scene in scene_ids
+        ):
