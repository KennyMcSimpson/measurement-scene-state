+            }
+            actual_keys = {(r["key"], r["scene_id"], r["role"]) for r in context_rows}
+            if actual_keys != expected_keys:
+                raise ValueError("Context evaluation state keys do not match the plan")
+    for rows in (query_rows, oracle_rows):
