+        "primary_contrast": "DEPTH_GAIN = AbsRel(C0 dense+surface) - AbsRel(C1 depth+surface)",
+        "secondary_contrast": "SURFACE_WITH_DEPTH_GAIN = AbsRel(C2) - AbsRel(C1); descriptive only",
+        "seeds": SEEDS,
