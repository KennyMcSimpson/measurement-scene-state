+    ci = value["ci95"]
+    return f"{value['mean']:.6f}，95% CI [{ci[0]:.6f}, {ci[1]:.6f}]"
+
+
+def negated(value):
+    """Exact sign flip of a paired scene contrast: mean, CI and counts."""
+    if value is None:
+        return None
+    lo, hi = value["ci95"]
+    return {
+        **value,
+        "mean": -value["mean"],
+        "ci95": [-hi, -lo],
+        "positive": value["negative"],
+        "negative": value["positive"],
+    }
