+        "DENSE_FULL_CONTEXT_GAIN": number(results["full_context_gain"]["C0"]["mean"]),
+        "DEPTH_FULL_CONTEXT_GAIN": number(results["full_context_gain"]["C1"]["mean"]),
+        "DEPTH_FULL_CONTEXT_GAIN_CI": results["full_context_gain"]["C1"]["ci95"],
