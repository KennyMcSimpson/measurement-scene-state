+from mcss.mechanism_pilot.visibility import common_visibility_masks
+
+METRICS = (
+    "rgb_mse",
+    "rgb_psnr",
+    "rgb_ssim",
+    "depth_absrel",
+    "depth_rmse",
+    "depth_delta1",
+    "opacity",
