+                if any(r.get("status") == "FAIL" and r["scene_id"] == sid for r in geometry):
+                    diagnostic.update(status="INELIGIBLE", reason="native_geometry_check_failed")
+                quality_rows[sid], feasibility[sid] = quality, diagnostic
