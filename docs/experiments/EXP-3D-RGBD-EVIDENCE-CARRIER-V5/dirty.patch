+        points = bounds[0] + fractions * (bounds[1] - bounds[0])
+        support = observed_camera_support(points, cameras)["supported_candidates"]
+        if support >= 2:
+            options.append((pair, support))
+    for a, b in itertools.combinations(options, 2):
