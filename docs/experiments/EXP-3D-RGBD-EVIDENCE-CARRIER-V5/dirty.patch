+                    json.dumps(
+                        {
+                            "time": time.time(),
+                            "scene_id": sid,
+                            "path": str(path),
+                            "operation": operation,
+                            "purpose": "unseen_data_geometry_only",
+                            "official_split": "train",
+                        }
+                    )
+                    + "\n"
+                )
+                log.flush()
+
+            for plan, archive, _reader in zip(plans, archives, readers, strict=True):
+                sid = plan["scene_id"]
+                for member in plan["members"]:
+                    dest = output / "raw" / member
