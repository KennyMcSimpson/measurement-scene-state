+    for name in ("train_depth_prior.json", "data_provenance.json"):
+        shutil.copyfile(V2 / name, root / name)
+    hashes = {
+        seed: {v: parameter_hash(make_carrier(v, seed, "cpu", near, far)) for v in VARIANT_SPECS}
+        for seed in SEEDS
