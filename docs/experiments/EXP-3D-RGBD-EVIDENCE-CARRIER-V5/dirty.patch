+        "DENSE_QUERY_ABSREL": number(groups["C0|direct"]["query_metrics"]["depth_absrel"]["mean"]),
+        "DEPTH_QUERY_ABSREL": number(groups["C1|direct"]["query_metrics"]["depth_absrel"]["mean"]),
+        "DEPTH_NO_SURFACE_QUERY_ABSREL": number(
