+        "checkpoint_rationale": "identical to V4 (V3 dense runs peaked at 500 steps)",
+        "learning_rate": 0.001,
+        "optimizer": "Adam",
+        "weight_decay": 0,
+        "lr_schedule": "constant",
+        "gradient_clip": 1.0,
+        "batch_scenes": 1,
