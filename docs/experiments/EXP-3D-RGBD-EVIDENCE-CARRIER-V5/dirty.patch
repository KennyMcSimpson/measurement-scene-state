+#!/usr/bin/env python3
+"""V5 independent postrun checks, preservation audit, and portable numeric archive."""
+
+from __future__ import annotations
+
+import argparse
+import gzip
+import hashlib
+import json
+import shutil
+import subprocess
+import tarfile
+from pathlib import Path
+
