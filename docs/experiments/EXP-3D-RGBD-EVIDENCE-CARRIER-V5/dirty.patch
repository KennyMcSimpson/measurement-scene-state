+    barrier.assert_ready()
+    access = []
+    for record in manifest["scenes"]:
+        for frame in record["frames"]:
+            for field in ("rgb", "depth"):
+                path = _resolve(manifest_path.parent, frame[field])
+                access.append(
+                    {
+                        "scene_id": record["scene_id"],
