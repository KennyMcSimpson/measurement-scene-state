+        volumes.add(volume)
+        if len(selected) == 24:
+            break
+    dev_ids, holdout_ids = selected[::2], selected[1::2]
+    validate_roles_disjoint(train_ids, exposed_ids, dev_ids, holdout_ids, assets)
