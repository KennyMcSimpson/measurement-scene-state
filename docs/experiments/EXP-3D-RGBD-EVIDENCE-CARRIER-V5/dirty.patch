+                    rgb_small, depth_small = resize_rgb_depth(rgb, depth)
+                    rgb_out, depth_out = prepared / f"{fid:04d}.png", prepared / f"{fid:04d}.npy"
+                    Image.fromarray(rgb_small).save(rgb_out)
