+
+@pytest.mark.parametrize(
+    "fault",
+    [
+        "missing_query",
+        "missing_empty_region",
+        "bad_partition",
+        "changed_mask",
+        "missing_context",
+        "protected",
+        "chosen_primary",
+        "missing_state",
