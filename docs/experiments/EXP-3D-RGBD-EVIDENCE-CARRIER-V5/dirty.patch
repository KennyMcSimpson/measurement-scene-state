+        {
+            "variants": {
+                v: {**spec, "config": asdict(carrier_config())} for v, spec in VARIANT_SPECS.items()
+            },
+            "parameter_count": COUNTS,
+            "shared_parameter_hash_by_seed": {str(s): h["C0"] for s, h in hashes.items()},
