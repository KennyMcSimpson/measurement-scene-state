+                    )
+                    if fid == plan["frame_ids"][0]:
+                        position = hdf(
+                            raw / f"images/scene_cam_00_geometry_hdf5/frame.{fid:04d}.position.hdf5"
+                        )
+                        try:
+                            geometry.append(
+                                check_geometry(
+                                    sid,
+                                    depth,
+                                    position,
+                                    pose,
+                                    calibrated_intrinsics(calibration_rows[sid], depth.shape),
+                                    scale,
+                                )
+                            )
+                        except ValueError as exc:
